# AMR Universal — environment configuration
# Copy to .env for local development. On Render, set these in the dashboard
# (render.yaml declares them; sync: false means you enter values by hand).

# Public base URL of the site. No trailing slash.
# On Render this is your https://<service-name>.onrender.com URL.
# When the custom domain arrives, change this one value and redeploy.
BASE_URL=http://localhost:3000

# Port (Render sets this automatically; local default 3000)
PORT=3000

# ---- WhatsApp Business Cloud API (leave blank to run the site without it) ----
# App secret from Meta developer app > App settings > Basic
META_APP_SECRET=

# A string you invent. You will type the same string into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=

# Permanent System User access token (see README section 4)
WHATSAPP_ACCESS_TOKEN=

# Phone number ID (NOT the phone number) from WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=

# Comma-separated E.164 numbers allowed to manage the desk, digits only, no +
# e.g. 447700900123,447700900456
ADMIN_WHATSAPP_NUMBERS=

# ---- Admin ----
# Token protecting /admin/subscribers.csv — invent a long random string
ADMIN_TOKEN=

# Where SQLite and lot photos live. On Render the disk is mounted at /var/data.
# Locally this defaults to ./data — you normally do not need to set it.
# DATA_DIR=/var/data
